rules_version = '2';
// Three Pyramids Buffet — permanent rules (no expiry date).
// The app has no sign-in, so the rules keep each document to the shape the app writes.
service cloud.firestore {
  match /databases/{database}/documents {

    // the menu, names, departments, sugar / methods, sound, admin password hash
    match /settings/main {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['names', 'departments', 'menu', 'drinkOptions', 'drinkMethods', 'soundSettings', 'adminHash', 'updatedAt'])
        && request.resource.data.names is list && request.resource.data.menu is map;
    }
    // the drinks' photos
    match /settings/images {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['images', 'updatedAt']) && request.resource.data.images is map;
    }

    // one document per order
    match /orders/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['id', 'guest', 'dept', 'items', 'time', 'status', 'createdAt', 'statusTimes', 'app'])
        && request.resource.data.guest is string && request.resource.data.guest.size() > 0 && request.resource.data.guest.size() <= 80
        && request.resource.data.items is list && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 30
        && request.resource.data.status == 'جديد'
        && string(request.resource.data.id) == id;
      // the buffet team moves the status (جديد → تم الاستلام → جاري التحضير → جاهز → تم التسليم)
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusTimes'])
        && request.resource.data.status in ['جديد', 'تم الاستلام', 'جاري التحضير', 'جاهز', 'تم التسليم'];
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
